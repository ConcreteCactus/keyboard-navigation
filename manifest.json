{
    "manifest_version": 3,
    "name": "Keyboard Navigation",
    "version": "1.1",
    "icons": {
        "16": "icon.png"
    },

    "description": "Makes it easier to navigate using only a keyboard.",
    "author": "Áron Hárnási",

    "content_scripts": [
        {
            "matches": [ "<all_urls>" ],
            "js": ["keyboard-navigation.js"]
        }
    ],
    "action": {
        "default_title": "Keyboard Navigation Settings",
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "options.html"
    },
    "permissions": [ "storage" ],
    "browser_specific_settings": {
        "gecko": {
            "id": "keyboard-navigation@aronharnasi.com",
            "update_url": "https://raw.githubusercontent.com/ConcreteCactus/keyboard-navigation/refs/heads/master/update-manifest.json"
        }
    }
}


